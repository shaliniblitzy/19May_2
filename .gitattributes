# .gitattributes — Git attributes for line endings, diff behavior, and Linguist hints.
#
# References:
#   - https://git-scm.com/docs/gitattributes
#   - https://github.com/github-linguist/linguist/blob/main/docs/overrides.md
#
# Conventions:
#   - LF line endings are enforced globally; pair with `.editorconfig` for
#     editor-side defense-in-depth.
#   - Binary file extensions are marked explicitly to prevent corruption when
#     Git mis-detects them as text.
#   - Linguist overrides ensure GitHub's language statistics reflect the
#     platform's actual focus (HCL, Rego, YAML, Mermaid) rather than the
#     incidental breakdown caused by large generated/vendored YAML/JSON.
#   - `export-ignore` keeps `git archive` outputs lean for adopters who fork.
#   - Inline `#` comments are NOT supported in `.gitattributes`; every comment
#     is on its own line.

# ---------------------------------------------------------------------------
# Default: enforce LF normalization across all text files
# ---------------------------------------------------------------------------
# `text=auto` lets Git detect text vs binary, `eol=lf` normalizes line endings
# to LF on checkout regardless of host OS, matching `.editorconfig`.

* text=auto eol=lf

# ---------------------------------------------------------------------------
# Explicit text files (LF line endings)
# ---------------------------------------------------------------------------
# Documentation and prose
*.md           text eol=lf
*.markdown     text eol=lf
*.mdx          text eol=lf
*.txt          text eol=lf
*.rst          text eol=lf
*.adoc         text eol=lf

# Configuration: YAML / JSON / TOML / INI / properties
*.yml          text eol=lf
*.yaml         text eol=lf
*.json         text eol=lf
*.json5        text eol=lf
*.jsonc        text eol=lf
*.toml         text eol=lf
*.ini          text eol=lf
*.cfg          text eol=lf
*.conf         text eol=lf
*.properties   text eol=lf
*.env          text eol=lf
*.env.*        text eol=lf

# Infrastructure as Code: Terraform / OpenTofu / HCL
*.tf           text eol=lf
*.tfvars       text eol=lf
*.hcl          text eol=lf
*.tftpl        text eol=lf

# Policy: OPA Rego
*.rego         text eol=lf

# Shell scripts (POSIX sh, bash, zsh)
*.sh           text eol=lf
*.bash         text eol=lf
*.zsh          text eol=lf

# Python
*.py           text eol=lf
*.pyi          text eol=lf
*.pyx          text eol=lf

# Go
*.go           text eol=lf
*.mod          text eol=lf
*.work         text eol=lf

# JavaScript / TypeScript ecosystem (Backstage, docs tooling, examples)
*.js           text eol=lf
*.cjs          text eol=lf
*.mjs          text eol=lf
*.ts           text eol=lf
*.cts          text eol=lf
*.mts          text eol=lf
*.jsx          text eol=lf
*.tsx          text eol=lf
*.vue          text eol=lf

# Web / styles (docs theme overrides, Backstage UI extensions)
*.html         text eol=lf
*.htm          text eol=lf
*.css          text eol=lf
*.scss         text eol=lf
*.sass         text eol=lf
*.less         text eol=lf

# Diagrams: Mermaid sources embedded in docs
*.mmd          text eol=lf
*.mermaid      text eol=lf

# Container / build manifests
Dockerfile         text eol=lf
Dockerfile.*       text eol=lf
*.dockerfile       text eol=lf
Containerfile      text eol=lf
Makefile           text eol=lf
GNUmakefile        text eol=lf
*.mk               text eol=lf
Jenkinsfile        text eol=lf

# Templates
*.tpl          text eol=lf
*.tmpl         text eol=lf
*.gotmpl       text eol=lf
*.j2           text eol=lf
*.jinja        text eol=lf
*.jinja2       text eol=lf

# Lockfiles & checksums (committed for reproducible builds; marked as text)
*.lock         text eol=lf
package-lock.json     text eol=lf
yarn.lock             text eol=lf
pnpm-lock.yaml        text eol=lf
Pipfile.lock          text eol=lf
poetry.lock           text eol=lf
uv.lock               text eol=lf
Cargo.lock            text eol=lf
go.sum                text eol=lf
.terraform.lock.hcl   text eol=lf

# Patches / diffs
*.patch        text eol=lf
*.diff         text eol=lf

# SVG is XML-based text, not binary; allow rendering in diffs.
*.svg          text eol=lf

# ---------------------------------------------------------------------------
# Windows-only files (CRLF preserved if adopters add them later)
# ---------------------------------------------------------------------------
# None ship today; declared defensively so future additions don't break.

*.bat          text eol=crlf
*.cmd          text eol=crlf
*.ps1          text eol=crlf
*.psm1         text eol=crlf
*.psd1         text eol=crlf

# ---------------------------------------------------------------------------
# Binary files — disable diff and merge, never normalize line endings
# ---------------------------------------------------------------------------
# Images (rasters; SVG is intentionally text above)
*.png          binary
*.jpg          binary
*.jpeg         binary
*.gif          binary
*.bmp          binary
*.tif          binary
*.tiff         binary
*.webp         binary
*.avif         binary
*.heic         binary
*.ico          binary

# Documents (treated as opaque to Git)
*.pdf          binary
*.doc          binary
*.docx         binary
*.xls          binary
*.xlsx         binary
*.ppt          binary
*.pptx         binary

# Archives & compressed bundles
*.zip          binary
*.tar          binary
*.tar.gz       binary
*.tgz          binary
*.tar.bz2      binary
*.tbz2         binary
*.tar.xz       binary
*.txz          binary
*.gz           binary
*.bz2          binary
*.xz           binary
*.zst          binary
*.7z           binary
*.rar          binary

# Executables & shared libraries
*.exe          binary
*.dll          binary
*.so           binary
*.so.*         binary
*.dylib        binary
*.a            binary
*.o            binary
*.obj          binary
*.lib          binary

# Java / JVM artifacts
*.jar          binary
*.war          binary
*.ear          binary
*.class        binary

# Python bytecode and wheels
*.pyc          binary
*.pyo          binary
*.pyd          binary
*.whl          binary
*.egg          binary

# Fonts (Backstage UI extensions / docs theme assets)
*.woff         binary
*.woff2        binary
*.eot          binary
*.ttf          binary
*.otf          binary

# Multimedia (docs screencasts / demos)
*.mp3          binary
*.mp4          binary
*.mov          binary
*.webm         binary
*.ogg          binary
*.wav          binary

# Container / Helm package archives are covered by *.tgz above.

# Cryptographic / signature artifacts (binary forms)
*.p12          binary
*.pfx          binary
*.crt          binary
*.cer          binary
*.der          binary
*.gpg          binary
*.pgp          binary

# Sigstore / cosign signature bundles
*.sig          binary
*.bundle       binary

# ---------------------------------------------------------------------------
# Linguist overrides — accurate GitHub language statistics
# ---------------------------------------------------------------------------
# Without these overrides, GitHub Linguist would classify this repo as
# overwhelmingly YAML/JSON due to manifest volume, hiding the policy
# (Rego), IaC (HCL), and diagram (Mermaid) content that defines the
# platform. Reference: linguist/docs/overrides.md.

# --- Vendored content (excluded from language stats) ---
# Helm sub-charts pulled by `helm dependency update` live under charts/.
helm/*/charts/**                              linguist-vendored
helm/**/charts/**                             linguist-vendored
# Backstage template skeletons are scaffolding, not first-class source.
backstage/templates/*/skeleton/**             linguist-vendored

# --- Generated content (excluded from language stats) ---
# Argo CD and Flux bootstrap manifests are produced by upstream installers
# (`kubectl kustomize` / `flux install --export`); treat as generated so
# their size doesn't dominate Linguist's pie chart.
gitops/argocd/install/install.yaml            linguist-generated
gitops/argocd/install/*.yaml                  linguist-generated
gitops/flux/install/gotk-components.yaml      linguist-generated
gitops/flux/install/*.yaml                    linguist-generated
progressive-delivery/argo-rollouts/install/*.yaml   linguist-generated
progressive-delivery/flagger/install/*.yaml         linguist-generated
security/secrets/external-secrets/install.yaml      linguist-generated

# --- Documentation classification (excluded from "code" stats) ---
# Treat the documentation site and dashboards as documentation, not code.
docs/**                                       linguist-documentation
observability/grafana/dashboards/*.json       linguist-documentation
**/CHANGELOG.md                               linguist-documentation
CHANGELOG.md                                  linguist-documentation

# --- Language identification (recognize less-common languages) ---
# OPA Rego — Linguist recognizes Rego but explicit hints are safest.
*.rego         linguist-language=Rego

# HCL family — Terraform, OpenTofu, Vault policy
*.tf           linguist-language=HCL
*.tfvars       linguist-language=HCL
*.hcl          linguist-language=HCL
.terraform.lock.hcl    linguist-language=HCL

# Mermaid diagram sources
*.mmd          linguist-language=Mermaid
*.mermaid      linguist-language=Mermaid

# Dockerfile variants
Dockerfile.*   linguist-language=Dockerfile
*.dockerfile   linguist-language=Dockerfile
Containerfile  linguist-language=Dockerfile

# ---------------------------------------------------------------------------
# Diff customization
# ---------------------------------------------------------------------------
# Suppress noisy diffs on machine-managed files.

# Lockfiles change frequently and produce large, low-value diffs.
*.lock                -diff
package-lock.json     -diff
yarn.lock             -diff
pnpm-lock.yaml        -diff
Pipfile.lock          -diff
poetry.lock           -diff
uv.lock               -diff
Cargo.lock            -diff
.terraform.lock.hcl   -diff

# Go module sums and checksum manifests
go.sum         -diff
*.sum          -diff

# Terraform state must never be committed; defensive rule if it slips in.
*.tfstate      -diff
*.tfstate.*    -diff

# Treat generated K8s/GitOps installers as opaque in diffs (still text).
gitops/argocd/install/install.yaml            -diff
gitops/flux/install/gotk-components.yaml      -diff

# Custom diff drivers for richer hunk headers
*.tf           diff=hcl
*.tfvars       diff=hcl
*.hcl          diff=hcl
*.py           diff=python
*.go           diff=golang
*.md           diff=markdown
*.css          diff=css
*.html         diff=html

# ---------------------------------------------------------------------------
# Merge customization
# ---------------------------------------------------------------------------
# Lockfiles should not three-way-merge — regenerate instead.

*.lock                merge=ours
package-lock.json     merge=ours
yarn.lock             merge=ours
pnpm-lock.yaml        merge=ours

# Generated installers shouldn't be merged either; re-export upstream.
gitops/argocd/install/install.yaml            merge=ours
gitops/flux/install/gotk-components.yaml      merge=ours

# ---------------------------------------------------------------------------
# Export-ignore — exclude dev/governance files from `git archive` tarballs
# ---------------------------------------------------------------------------
# Adopters running `git archive` (e.g., for release bundles or for use with
# `helm package`-style consumers) should not receive the CI configuration,
# governance files, or pre-commit hooks; those are repository-only concerns.

/.github                       export-ignore
/.gitlab-ci                    export-ignore
/.gitlab-ci.yml                export-ignore
/.pre-commit-config.yaml       export-ignore
/.editorconfig                 export-ignore
/.gitignore                    export-ignore
/.gitattributes                export-ignore
/.dependabot                   export-ignore
/.devcontainer                 export-ignore
/.vscode                       export-ignore
/.idea                         export-ignore
/CONTRIBUTING.md               export-ignore
/CODE_OF_CONDUCT.md            export-ignore
/CODEOWNERS                    export-ignore
/SECURITY.md                   export-ignore

# Tests and example fixtures should not ship in published archives.
**/__tests__                   export-ignore
**/__snapshots__               export-ignore
**/testdata                    export-ignore
**/*.test.go                   export-ignore
**/*_test.go                   export-ignore
**/*.spec.ts                   export-ignore
**/*.test.ts                   export-ignore

# ---------------------------------------------------------------------------
# Filter / clean-smudge (intentionally none)
# ---------------------------------------------------------------------------
# This repository does not use Git LFS for tracked content; downstream
# adopters may add `*.<ext> filter=lfs diff=lfs merge=lfs -text` rules
# under their own fork. We do not pre-declare any LFS patterns here.
