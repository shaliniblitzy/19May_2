# .gitignore — patterns excluded from version control.
# Grouped by concern. Anything secret-related is in `gitleaks` rules too.
#
# Conventions:
#   - Trailing wildcards only (no leading `**/foo`-style anti-patterns).
#   - Whitelist patterns (`!`) are used sparingly and ONLY for files that
#     must remain tracked (e.g., public keys, example env files).
#   - Lockfiles (package-lock.json, yarn.lock, pnpm-lock.yaml, Pipfile.lock,
#     poetry.lock, Cargo.lock, go.sum, .terraform.lock.hcl) are intentionally
#     NOT ignored — they must be committed for reproducible builds.
#
# Reference: https://git-scm.com/docs/gitignore

# ---------------------------------------------------------------------------
# Operating System artifacts
# ---------------------------------------------------------------------------

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Icon?

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# ---------------------------------------------------------------------------
# Editor / IDE
# ---------------------------------------------------------------------------

# JetBrains (IntelliJ IDEA, GoLand, PyCharm, WebStorm, etc.)
.idea/
*.iml
*.iws
*.ipr
out/

# VS Code (allow shared settings if present, ignore local)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Vim
*.swp
*.swo

# Emacs (lock files contain literal `#` characters)
\#*\#
.\#*

# Sublime Text
*.sublime-project
*.sublime-workspace

# ---------------------------------------------------------------------------
# Logs and temporary files
# ---------------------------------------------------------------------------
*.log
logs/
tmp/
temp/
*.tmp
*.bak
*.orig
.cache/

# ---------------------------------------------------------------------------
# Terraform & OpenTofu
# ---------------------------------------------------------------------------

# Local .terraform working directories
**/.terraform/*

# Terraform state files (MAY contain secrets — never commit)
*.tfstate
*.tfstate.*
*.tfstate.backup

# Crash log files
crash.log
crash.*.log

# Variable files often contain sensitive info — KEEP example templates tracked
*.tfvars
*.tfvars.json
!terraform.tfvars.example
!*.tfvars.example

# Override files are conventionally local-only
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI / plugin caches (per-developer)
.terraformrc
terraform.rc

# NOTE: .terraform.lock.hcl is intentionally NOT ignored.
# It must be committed (HashiCorp best practice) so providers do not drift
# between contributors. Do not add a pattern that ignores it.

# ---------------------------------------------------------------------------
# Helm
# ---------------------------------------------------------------------------

# Downloaded chart archives and dependency caches
helm/**/charts/
helm/**/*.tgz
charts/
*.tgz

# Helm local working state
.helm/
helm-debug.yaml

# ---------------------------------------------------------------------------
# Kubernetes & Kustomize
# ---------------------------------------------------------------------------

# kubeconfigs are per-developer/per-environment and may contain credentials
kubeconfig
.kubeconfig
*.kubeconfig

# Kustomize build outputs
kustomization.build.yaml

# ---------------------------------------------------------------------------
# Container builders (Docker / BuildKit / buildx)
# ---------------------------------------------------------------------------

# Docker per-user config
.docker/

# BuildKit / buildx caches and local-only daemon config
.buildx-cache/
**/buildkitd.toml.local

# ---------------------------------------------------------------------------
# Cosign / Sigstore (supply-chain signing material)
# ---------------------------------------------------------------------------

# Private keys MUST NEVER be in Git
cosign.key
*.pem
*.key

# Public verifier key is an intentional, tracked artifact
!security/supply-chain/cosign/cosign.pub

# Ephemeral Fulcio short-lived certificates (keyless signing)
ephemeral.*.crt

# ---------------------------------------------------------------------------
# SBOM and scan outputs (Syft / Grype / Trivy)
# ---------------------------------------------------------------------------
sbom.json
sbom.spdx.json
sbom.cyclonedx.json
syft.*.json
grype.*.json
trivy-report.*.json
*.sarif

# ---------------------------------------------------------------------------
# Python (mkdocs, pre-commit, checkov, etc.)
# ---------------------------------------------------------------------------

# Byte-compiled / cached
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# pytest / coverage / tox
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Type-checkers and linters
.mypy_cache/
.pyright_cache/
.ruff_cache/

# mkdocs build output (the rendered static site)
site/

# ---------------------------------------------------------------------------
# Node / JS (Backstage, docs tooling, sample-service builds)
# ---------------------------------------------------------------------------
node_modules/
package-lock.json.bak
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm
.yarn-integrity
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# Build outputs
.next/
# NOTE: `dist/` and `out/` are already covered by the Python and JetBrains
# sections above; do not duplicate here.

# Test coverage
coverage/
.nyc_output/

# ---------------------------------------------------------------------------
# Go (Argo CD plugins, Tekton tasks, one-off CLI helpers)
# ---------------------------------------------------------------------------

# Test binaries and outputs
*.test
*.out
*.cover

# Vendored dependencies (when used)
vendor/

# Go workspace files are typically per-developer
go.work
go.work.sum

# ---------------------------------------------------------------------------
# Secrets, env files, credentials (defense in depth — `gitleaks` is primary)
# ---------------------------------------------------------------------------

# Generic env files
.env.*
!.env.example
!.env.template

# Cloud SDK credential caches (per-developer)
.aws/
.gcloud/
.azure/

# Generic credential artifacts
credentials
credentials.json
service-account*.json
gcp-key*.json
*.pfx
*.p12

# Local-only secret material
secrets/local/

# ---------------------------------------------------------------------------
# Backstage local build artifacts
# ---------------------------------------------------------------------------
backstage/packages/*/dist/
backstage/packages/*/dist-types/
backstage/.cache/
backstage/.next/

# ---------------------------------------------------------------------------
# Pre-commit framework cache
# ---------------------------------------------------------------------------
.pre-commit-cache/

# ---------------------------------------------------------------------------
# Repository-specific
# ---------------------------------------------------------------------------

# Local development overrides
local/
.local/
*.local

# Blitzy / project-specific scratch (not user-facing)
.blitzy/
.blitzyignore
